<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PaniersFermiers.Views.ReservationPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PfFond}">

    <Grid RowDefinitions="Auto,*">

        <!-- En-tête -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="12,40,20,8">
            <Button Text="←" FontSize="24" Style="{StaticResource BoutonLien}"
                    TextColor="{StaticResource PfTexte}" Command="{Binding RetourCommand}" />
            <Label Grid.Column="1" Text="Réservation Panier" FontSize="18" FontAttributes="Bold"
                   TextColor="{StaticResource PfTexte}" VerticalOptions="Center" />
        </Grid>

        <!-- État normal -->
        <ScrollView Grid.Row="1" IsVisible="{Binding ContenuVisible}">
            <VerticalStackLayout Padding="20,8,20,24">

                <Label Text="Votre commande" Style="{StaticResource TitreEcran}" />
                <Label Text="Vérifiez vos produits frais avant de sélectionner votre créneau de retrait."
                       Style="{StaticResource SousTitre}" Margin="0,4,0,16" />

                <!-- Ligne de commande -->
                <Border Style="{StaticResource Carte}">
                    <VerticalStackLayout Padding="14" Spacing="14">

                        <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="12">
                            <Border BackgroundColor="{StaticResource PfVertClair}" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10" WidthRequest="72" HeightRequest="72">
                                <Label Text="{Binding Emoji}" FontSize="34"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                <Label Text="{Binding Nom}" FontSize="16" FontAttributes="Bold"
                                       TextColor="{StaticResource PfTexte}" />
                                <Border BackgroundColor="{StaticResource PfVertClair}" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 6" Padding="8,2" HorizontalOptions="Start">
                                    <Label Text="Bio &amp; Local" FontSize="12" FontAttributes="Bold"
                                           TextColor="{StaticResource PfVertFonce}" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                <Label Text="{Binding TotalTexte}" FontSize="16" FontAttributes="Bold"
                                       HorizontalTextAlignment="End" TextColor="{StaticResource PfTexte}" />
                                <Label Text="{Binding PrixKgTexte}" FontSize="12"
                                       HorizontalTextAlignment="End"
                                       TextColor="{StaticResource PfTexteSecondaire}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Button Text="🗑 Supprimer" Style="{StaticResource BoutonLien}"
                                    TextColor="{StaticResource PfErreur}" HorizontalOptions="Start"
                                    Command="{Binding SupprimerCommand}" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                                <Button Text="−" Style="{StaticResource BoutonPrincipal}"
                                        WidthRequest="44" HeightRequest="44" Padding="0" FontSize="20"
                                        Command="{Binding DiminuerCommand}"
                                        IsEnabled="{Binding PeutDiminuer}" />
                                <Label Text="{Binding Quantite}" FontSize="18" FontAttributes="Bold"
                                       TextColor="{StaticResource PfTexte}" VerticalOptions="Center" />
                                <Button Text="+" Style="{StaticResource BoutonPrincipal}"
                                        WidthRequest="44" HeightRequest="44" Padding="0" FontSize="20"
                                        Command="{Binding AugmenterCommand}"
                                        IsEnabled="{Binding PeutAugmenter}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Zéro emballage -->
                <Border BackgroundColor="#EAF3EA" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                        Padding="14" Margin="0,16,0,0">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="🛍 Démarche zéro emballage" FontSize="14" FontAttributes="Bold"
                               TextColor="{StaticResource PfTexte}" />
                        <Label Text="Zéro plastique à usage unique : pensez à apporter votre cabas, panier en osier ou pochons en tissu lors de votre passage au point relais !"
                               FontSize="13" TextColor="{StaticResource PfTexteSecondaire}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Détail du règlement -->
                <Border Style="{StaticResource Carte}" Margin="0,16,0,0">
                    <VerticalStackLayout Padding="16" Spacing="10">
                        <Label Text="Détail du règlement" FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource PfTexte}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding NombreArticlesTexte}" Style="{StaticResource Texte}" />
                            <Label Grid.Column="1" Text="{Binding TotalTexte}" FontSize="14"
                                   FontAttributes="Bold" TextColor="{StaticResource PfTexte}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Frais de service / point relais (offerts)" Style="{StaticResource Texte}" />
                            <Label Grid.Column="1" Text="0 FCFA" FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource PfVert}" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource PfBordure}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="Total à régler au retrait" FontSize="16" FontAttributes="Bold"
                                       TextColor="{StaticResource PfTexte}" />
                                <Label Text="Règlement sur place (espèces ou Mobile Money)" FontSize="12"
                                       TextColor="{StaticResource PfTexteSecondaire}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding TotalTexte}" FontSize="20"
                                   FontAttributes="Bold" TextColor="{StaticResource PfVertFonce}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Choisir le point de retrait →" Style="{StaticResource BoutonPrincipal}"
                        Command="{Binding ChoisirPointCommand}" Margin="0,20,0,0" />
                <Label Text="🔒 Réservation sans débit bancaire immédiat" FontSize="12"
                       TextColor="{StaticResource PfTexteSecondaire}"
                       HorizontalOptions="Center" Margin="0,10,0,0" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- État panier vide -->
        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding Vide}" Padding="20,60,20,0" Spacing="12">
            <Label Text="🧺" FontSize="60" HorizontalOptions="Center" />
            <Label Text="Votre panier est vide" Style="{StaticResource TitreEcran}" FontSize="22"
                   HorizontalOptions="Center" />
            <Button Text="Voir les paniers" Style="{StaticResource BoutonPrincipal}"
                    Command="{Binding VoirPaniersCommand}" Margin="0,12,0,0" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
