<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PaniersFermiers.Views.RegisterPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PfFond}">

    <ScrollView>
        <VerticalStackLayout Padding="20,40,20,24" Spacing="0">

            <!-- En-tête avec retour -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Button Text="←" FontSize="24" Style="{StaticResource BoutonLien}"
                        TextColor="{StaticResource PfTexte}"
                        Command="{Binding RetourCommand}" />
                <Label Grid.Column="1" Text="Inscription" FontSize="18" FontAttributes="Bold"
                       TextColor="{StaticResource PfTexte}" VerticalOptions="Center" />
            </Grid>

            <Label Text="Créer un compte" Style="{StaticResource TitreEcran}" Margin="0,12,0,0" />

            <!-- Nom -->
            <Label Text="Nom complet" Style="{StaticResource LabelChamp}" />
            <Border Style="{StaticResource ChampBorder}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Nom.AErreur}" Value="True">
                        <Setter Property="Stroke" Value="{StaticResource PfErreur}" />
                    </DataTrigger>
                </Border.Triggers>
                <Entry Style="{StaticResource ChampEntry}" Placeholder="ex : Clémentine Mercier"
                       Text="{Binding Nom.Valeur}" IsEnabled="{Binding FormulaireActif}" />
            </Border>
            <Label Text="{Binding Nom.Erreur}" IsVisible="{Binding Nom.AErreur}"
                   Style="{StaticResource TexteErreur}" />

            <!-- Email -->
            <Label Text="Adresse email" Style="{StaticResource LabelChamp}" />
            <Border Style="{StaticResource ChampBorder}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Email.AErreur}" Value="True">
                        <Setter Property="Stroke" Value="{StaticResource PfErreur}" />
                    </DataTrigger>
                </Border.Triggers>
                <Entry Style="{StaticResource ChampEntry}" Placeholder="clementine@exemple.cm"
                       Keyboard="Email"
                       Text="{Binding Email.Valeur}" IsEnabled="{Binding FormulaireActif}" />
            </Border>
            <Label Text="{Binding Email.Erreur}" IsVisible="{Binding Email.AErreur}"
                   Style="{StaticResource TexteErreur}" />

            <!-- Téléphone -->
            <Label Text="Numéro de téléphone" Style="{StaticResource LabelChamp}" />
            <Border Style="{StaticResource ChampBorder}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Telephone.AErreur}" Value="True">
                        <Setter Property="Stroke" Value="{StaticResource PfErreur}" />
                    </DataTrigger>
                </Border.Triggers>
                <Entry Style="{StaticResource ChampEntry}" Placeholder="6 90 12 34 56"
                       Keyboard="Telephone"
                       Text="{Binding Telephone.Valeur}" IsEnabled="{Binding FormulaireActif}" />
            </Border>
            <Label Text="{Binding Telephone.Erreur}" IsVisible="{Binding Telephone.AErreur}"
                   Style="{StaticResource TexteErreur}" />

            <!-- Mot de passe -->
            <Label Text="Mot de passe" Style="{StaticResource LabelChamp}" />
            <Border Style="{StaticResource ChampBorder}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding MotDePasse.AErreur}" Value="True">
                        <Setter Property="Stroke" Value="{StaticResource PfErreur}" />
                    </DataTrigger>
                </Border.Triggers>
                <Entry Style="{StaticResource ChampEntry}" Placeholder="Au moins 8 caractères"
                       IsPassword="True"
                       Text="{Binding MotDePasse.Valeur}" IsEnabled="{Binding FormulaireActif}" />
            </Border>
            <Label Text="{Binding MotDePasse.Erreur}" IsVisible="{Binding MotDePasse.AErreur}"
                   Style="{StaticResource TexteErreur}" />

            <!-- Confirmation -->
            <Label Text="Confirmer le mot de passe" Style="{StaticResource LabelChamp}" />
            <Border Style="{StaticResource ChampBorder}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Confirmation.AErreur}" Value="True">
                        <Setter Property="Stroke" Value="{StaticResource PfErreur}" />
                    </DataTrigger>
                </Border.Triggers>
                <Entry Style="{StaticResource ChampEntry}" Placeholder="Retapez le mot de passe"
                       IsPassword="True"
                       Text="{Binding Confirmation.Valeur}" IsEnabled="{Binding FormulaireActif}" />
            </Border>
            <Label Text="{Binding Confirmation.Erreur}" IsVisible="{Binding Confirmation.AErreur}"
                   Style="{StaticResource TexteErreur}" />

            <!-- Conditions -->
            <Grid ColumnDefinitions="Auto,*" Margin="0,20,0,0">
                <CheckBox IsChecked="{Binding CguAcceptees}" Color="{StaticResource PfVertFonce}"
                          VerticalOptions="Center" />
                <Label Grid.Column="1" Style="{StaticResource Texte}" VerticalOptions="Center"
                       Text="J'accepte les conditions d'utilisation et la charte paysanne locale" />
            </Grid>

            <Button Text="{Binding TexteBouton}" Style="{StaticResource BoutonPrincipal}"
                    Command="{Binding CreerCompteCommand}"
                    IsEnabled="{Binding PeutCreer}"
                    Margin="0,20,0,0" />

            <Label Text="Déjà inscrit ?" Style="{StaticResource Texte}"
                   HorizontalOptions="Center" Margin="0,24,0,0" />
            <Button Text="Se connecter" Style="{StaticResource BoutonLien}" FontSize="16"
                    HorizontalOptions="Center" Command="{Binding RetourCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>