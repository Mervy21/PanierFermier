<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PaniersFermiers.ViewModels"
             x:Class="PaniersFermiers.Views.CataloguePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PfFond}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ===== Bandeau d'accueil (dégradé vert) ===== -->
        <Grid Grid.Row="0" Padding="20,44,20,22" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource PfVertFonce}" Offset="0.0" />
                    <GradientStop Color="{StaticResource PfVert}" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Salutation}"
                   FontSize="24" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
            <!-- AMÉLIORATION : deux raccourcis (commandes + profil) -->
            <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="8">
                <Button Text="Commandes" ContentLayout="Left,6"
                        BackgroundColor="#33FFFFFF" TextColor="White" FontSize="13"
                        CornerRadius="18" HeightRequest="36" Padding="14,0"
                        Command="{Binding MesCommandesCommand}">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="PfIcons" Glyph="{StaticResource IcColis}" Color="White" Size="16" />
                    </Button.ImageSource>
                </Button>
                <Button Text="{StaticResource IcProfil}" FontFamily="PfIcons"
                        BackgroundColor="#33FFFFFF" TextColor="White" FontSize="18"
                        CornerRadius="18" HeightRequest="36" WidthRequest="36" Padding="0"
                        SemanticProperties.Description="Mon profil"
                        Command="{Binding ProfilCommand}" />
            </HorizontalStackLayout>
            <Label Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0"
                   Text="Des fruits et légumes frais, directement des producteurs du Cameroun"
                   FontSize="13" TextColor="#E3F1E5" />
        </Grid>

        <!-- ===== Recherche + filtres ===== -->
        <VerticalStackLayout Grid.Row="1" Padding="20,14,20,6" Spacing="12">

            <Border Style="{StaticResource ChampBorder}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                    <Label Text="{StaticResource IcRecherche}" FontFamily="PfIcons" FontSize="20" TextColor="{StaticResource PfTexteSecondaire}"
                           VerticalOptions="Center" />
                    <Entry Grid.Column="1" Style="{StaticResource ChampEntry}"
                           Placeholder="Rechercher un fruit ou un légume..."
                           Text="{Binding Recherche}" />
                </Grid>
            </Border>

            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8">
                    <Button Text="{Binding TexteTous}" Style="{StaticResource Chip}"
                            Command="{Binding FiltrerCommand}" CommandParameter="Tous">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding FiltreActif}" Value="Tous">
                                <Setter Property="BackgroundColor" Value="{StaticResource PfVertFonce}" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Légumes" Style="{StaticResource Chip}"
                            Command="{Binding FiltrerCommand}" CommandParameter="Légumes">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding FiltreActif}" Value="Légumes">
                                <Setter Property="BackgroundColor" Value="{StaticResource PfVertFonce}" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Fruits" Style="{StaticResource Chip}"
                            Command="{Binding FiltrerCommand}" CommandParameter="Fruits">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding FiltreActif}" Value="Fruits">
                                <Setter Property="BackgroundColor" Value="{StaticResource PfVertFonce}" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Tubercules" Style="{StaticResource Chip}"
                            Command="{Binding FiltrerCommand}" CommandParameter="Tubercules">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding FiltreActif}" Value="Tubercules">
                                <Setter Property="BackgroundColor" Value="{StaticResource PfVertFonce}" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </HorizontalStackLayout>
            </ScrollView>

            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8">
                <Label Text="Trier :" VerticalOptions="Center" FontSize="13"
                       TextColor="{StaticResource PfTexteSecondaire}" />
                <Button Text="Nom A-Z" Style="{StaticResource Chip}"
                        Command="{Binding TrierCommand}" CommandParameter="Nom">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding Tri}" Value="Nom">
                            <Setter Property="BackgroundColor" Value="{StaticResource PfVertFonce}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="Prix croissant" Style="{StaticResource Chip}"
                        Command="{Binding TrierCommand}" CommandParameter="PrixCroissant">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding Tri}" Value="PrixCroissant">
                            <Setter Property="BackgroundColor" Value="{StaticResource PfVertFonce}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="Prix décroissant" Style="{StaticResource Chip}"
                        Command="{Binding TrierCommand}" CommandParameter="PrixDecroissant">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding Tri}" Value="PrixDecroissant">
                            <Setter Property="BackgroundColor" Value="{StaticResource PfVertFonce}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>

        <!-- ===== Chargement / erreur / liste ===== -->
        <Grid Grid.Row="2" Padding="20,6,20,0">

            <ActivityIndicator IsRunning="{Binding EstChargement}" IsVisible="{Binding EstChargement}"
                               Color="{StaticResource PfVertFonce}"
                               VerticalOptions="Start" HorizontalOptions="Center" Margin="0,40,0,0" />

            <VerticalStackLayout IsVisible="{Binding AErreur}" Spacing="12"
                                 VerticalOptions="Start" Margin="0,40,0,0">
                <Label Text="{Binding ErreurChargement}" Style="{StaticResource TexteErreur}"
                       HorizontalOptions="Center" />
                <Button Text="Réessayer" Style="{StaticResource BoutonPrincipal}"
                        Command="{Binding ReessayerCommand}" />
            </VerticalStackLayout>

            <CollectionView ItemsSource="{Binding Produits}" IsVisible="{Binding ListeVisible}">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Margin="0,40,0,0" Spacing="8">
                        <Label Text="{StaticResource IcAucunResultat}" FontFamily="PfIcons" FontSize="48"
                               TextColor="{StaticResource PfDesactive}" HorizontalOptions="Center" />
                        <Label Text="Aucun produit ne correspond à votre recherche."
                               Style="{StaticResource SousTitre}"
                               HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Carte}" Margin="0,0,0,14">
                            <VerticalStackLayout>

                                <!-- Partie haute : toucher = ouvrir la fiche produit -->
                                <Grid ColumnDefinitions="84,*" ColumnSpacing="14" Padding="14,14,14,10">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CatalogueViewModel}}, Path=OuvrirProduitCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>

                                    <Border BackgroundColor="#DDF3D8" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 16"
                                            WidthRequest="84" HeightRequest="84">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding Categorie}" Value="Fruits">
                                                <Setter Property="BackgroundColor" Value="#FFE8C8" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding Categorie}" Value="Tubercules">
                                                <Setter Property="BackgroundColor" Value="#F1E4CF" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding Emoji}" FontSize="42"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding Nom}" FontSize="18" FontAttributes="Bold"
                                                   TextColor="{StaticResource PfTexte}" />
                                            <Border Grid.Column="1" BackgroundColor="#FDECEA" StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 8" Padding="8,2"
                                                    IsVisible="{Binding Epuise}">
                                                <Label Text="Hors saison" FontSize="11"
                                                       TextColor="{StaticResource PfErreur}" />
                                            </Border>
                                        </Grid>
                                        <Label Text="{Binding Description}" FontSize="12"
                                               TextColor="{StaticResource PfTexteSecondaire}"
                                               MaxLines="2" LineBreakMode="TailTruncation" />
                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="{Binding PrixKgTexte}" FontSize="16" FontAttributes="Bold"
                                                   TextColor="{StaticResource PfVertFonce}" VerticalOptions="Center" />
                                            <HorizontalStackLayout Spacing="2" VerticalOptions="Center">
                                                <Label Text="{StaticResource IcOrigine}" Style="{StaticResource Icone}" FontSize="15"
                                                       TextColor="{StaticResource PfTexteSecondaire}" />
                                                <Label Text="{Binding Origine}" FontSize="12"
                                                       TextColor="{StaticResource PfTexteSecondaire}" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Partie basse : quantité + ajout au panier -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="14,0,14,14">
                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <Button Text="−" Style="{StaticResource BoutonRond}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CatalogueViewModel}}, Path=DiminuerCommand}"
                                                CommandParameter="{Binding .}"
                                                IsEnabled="{Binding PeutDiminuer}" />
                                        <Label Text="{Binding QuantiteTexte}" FontSize="15" FontAttributes="Bold"
                                               WidthRequest="58" HorizontalTextAlignment="Center"
                                               TextColor="{StaticResource PfTexte}" VerticalOptions="Center" />
                                        <Button Text="+" Style="{StaticResource BoutonRond}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CatalogueViewModel}}, Path=AugmenterCommand}"
                                                CommandParameter="{Binding .}"
                                                IsEnabled="{Binding PeutAugmenter}" />
                                    </HorizontalStackLayout>

                                    <Button Grid.Column="1" Text="{Binding TexteAjout}"
                                            Style="{StaticResource BoutonPrincipal}"
                                            HeightRequest="42" FontSize="14"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CatalogueViewModel}}, Path=AjouterCommand}"
                                            CommandParameter="{Binding .}"
                                            IsEnabled="{Binding Disponible}" />
                                </Grid>

                                <!-- Rappel : déjà dans le panier -->
                                <Grid BackgroundColor="#EAF3EA" Padding="14,8" IsVisible="{Binding EstDansPanier}">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="{StaticResource IcCheck}" Style="{StaticResource Icone}" FontSize="15" />
                                        <Label Text="{Binding DansPanierTexte}" FontSize="12" FontAttributes="Bold"
                                               TextColor="{StaticResource PfVertFonce}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Grid>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- ===== Barre du panier (visible quand le panier n'est pas vide) ===== -->
        <Border Grid.Row="3" IsVisible="{Binding PanierNonVide}" Margin="16,8,16,16"
                BackgroundColor="{StaticResource PfVertFonce}" StrokeThickness="0"
                StrokeShape="RoundRectangle 18" Padding="18,14">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OuvrirPanierCommand}" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout>
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="{StaticResource IcPanier}" Style="{StaticResource Icone}" FontSize="22" TextColor="White" />
                        <Label Text="Voir mon panier" FontSize="16" FontAttributes="Bold" TextColor="White"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding ResumePanierTexte}" FontSize="12" TextColor="#D5E8D8" />
                </VerticalStackLayout>
                <Label Grid.Column="1" Text="{Binding TotalPanierTexte}" FontSize="18"
                       FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
